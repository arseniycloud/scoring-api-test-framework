# Copy to .env and fill in your own stand.
# Real credentials never go to the repo: .env locally (git-ignored),
# runner secrets or Vault in CI.

SCORING_BASE_URL=http://localhost:8080
SCORING_DB_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/scoring

# Optional settings (defaults live in utils/config.py)
SCORING_REQUEST_TIMEOUT=10
SCORING_RETRIES=3
SCORING_BACKOFF_FACTOR=0.5
SCORING_DECISION_TIMEOUT=15
SCORING_POLL_INTERVAL=0.5
